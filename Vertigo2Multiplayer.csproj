<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Vertigo2Multiplayer</AssemblyName>
    <Description>Multiplayer mod for Vertigo 2 VR using Steam Networking</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game Assembly References -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>D:\SteamLibrary\steamapps\common\Vertigo 2\vertigo2_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>D:\SteamLibrary\steamapps\common\Vertigo 2\vertigo2_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Steamworks.NET from game -->
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>D:\SteamLibrary\steamapps\common\Vertigo 2\vertigo2_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SteamVR -->
    <Reference Include="SteamVR">
      <HintPath>D:\SteamLibrary\steamapps\common\Vertigo 2\vertigo2_Data\Managed\SteamVR.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamVR_Actions">
      <HintPath>D:\SteamLibrary\steamapps\common\Vertigo 2\vertigo2_Data\Managed\SteamVR_Actions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity UI -->
    <Reference Include="UnityEngine.UI">
      <HintPath>D:\SteamLibrary\steamapps\common\Vertigo 2\vertigo2_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TextMeshPro -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>D:\SteamLibrary\steamapps\common\Vertigo 2\vertigo2_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Valve VR -->
    <Reference Include="SteamVR">
      <HintPath>D:\SteamLibrary\steamapps\common\Vertigo 2\vertigo2_Data\Managed\SteamVR.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
